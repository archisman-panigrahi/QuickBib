msgid "<p>GPLv3 license text not found in repository. See the <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">Read it online</a>.</p>"
msgstr "<p>O texto da licença GPLv3 não foi encontrado no repositório. Você pode <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">ler online</a>.</p>"

