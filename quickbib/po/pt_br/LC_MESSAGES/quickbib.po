#: quickbib/about_dialog.py:88
msgid "{app_name} fetches BibTeX entries from DOIs, arXiv IDs, and known journal URLs. It is a simple utility to quickly convert identifiers into usable BibTeX records."
msgstr "{app_name} busca entradas BibTeX a partir de DOIs, IDs do arXiv e URLs de periódicos conhecidos. É um utilitário simples para transformar rapidamente identificadores em registros BibTeX prontos para uso."

#: quickbib/about_dialog.py:89
msgid "QuickBib uses <a href=\"https://github.com/archisman-panigrahi/doi2bib3\">doi2bib3</a> as its backend for DOI to BibTeX conversion."
msgstr "QuickBib usa <a href=\"https://github.com/archisman-panigrahi/doi2bib3\">doi2bib3</a> como motor (backend) para a conversão de DOI em BibTeX."

#: quickbib/about_dialog.py:91
msgid "<b>Homepage:</b> <a href=\"{homepage}\">{homepage}</a><br><b>Source Code:</b> <a href=\"{repo_url}\">{repo_url}</a><br><b>Report Issues:</b> <a href=\"{issues_url}\">{issues_url}</a><br><br><b>Web app:</b> Check it out <a href=\"{webapp_url}\">here</a>."
msgstr "<b>Página inicial:</b> <a href=\"{homepage}\">{homepage}</a><br><b>Código-fonte:</b> <a href=\"{repo_url}\">{repo_url}</a><br><b>Relatar problemas:</b> <a href=\"{issues_url}\">{issues_url}</a><br><br><b>App web:</b> Confira <a href=\"{webapp_url}\">aqui</a>."

#: quickbib/about_dialog.py:94
msgid "<b>License:</b> Released under the <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">GNU General Public License Version 3</a>. Full text available on the <i>License</i> tab."
msgstr "<b>Licença:</b> Lançado sob a <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">GNU General Public License Version 3</a>. O texto completo está disponível na aba <i>Licença</i>."

#: quickbib/about_dialog.py:106
msgid " Significant Contributors"
msgstr "Colaboradores importantes"

#: quickbib/about_dialog.py:108
msgid "<a href=\"https://github.com/Kyuyrii/\">Kyuyrii</a>: Helped fix the snap package."
msgstr "<a href=\"https://github.com/Kyuyrii/\">Kyuyrii</a>: Ajudou a corrigir o pacote snap."

#: quickbib/about_dialog.py:110
msgid "This project was inspired by <a href=\"https://github.com/bibcure/doi2bib\">doi2bib</a>, whose development unfortunately stopped."
msgstr "Este projeto foi inspirado por <a href=\"https://github.com/bibcure/doi2bib\">doi2bib</a>, cujo desenvolvimento infelizmente foi interrompido."

#: quickbib/about_dialog.py:111
msgid "This project would not have been possible without the help from GitHub Copilot."
msgstr "Este projeto não teria sido possível sem a ajuda do GitHub Copilot."

#: quickbib/about_dialog.py:112
msgid "Bug reports and pull requests are welcome on the <a href=\"{repo_url}\">project's GitHub page</a>."
msgstr "Relatos de bugs e pull requests são bem-vindos na <a href=\"{repo_url}\">página do projeto no GitHub</a>."

#: quickbib/about_dialog.py:93
msgid "Want to help translate QuickBib? Improve an existing translation or add a new language on the <a href=\"{repo_url}\">project's GitHub page</a>."
msgstr "Quer ajudar a traduzir o QuickBib? Melhore uma tradução existente ou adicione um novo idioma na <a href=\"{repo_url}\">página do projeto no GitHub</a>."

#: quickbib/about_dialog.py:136
