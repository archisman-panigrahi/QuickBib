msgstr "Lizenz"

#: quickbib/about_dialog.py:88
msgid "{app_name} fetches BibTeX entries from DOIs, arXiv IDs, and known journal URLs. It is a simple utility to quickly convert identifiers into usable BibTeX records."
msgstr "{app_name} holt BibTeX-Einträge für DOIs, arXiv-IDs und bekannte Journal-URLs. Ein kleines Werkzeug, das Kennungen schnell in nutzbare BibTeX-Datensätze umwandelt."

#: quickbib/about_dialog.py:89
msgid "QuickBib uses <a href=\"https://github.com/archisman-panigrahi/doi2bib3\">doi2bib3</a> as its backend for DOI to BibTeX conversion."
msgstr "QuickBib nutzt <a href=\"https://github.com/archisman-panigrahi/doi2bib3\">doi2bib3</a> als Backend für die DOI→BibTeX-Konvertierung."

#: quickbib/about_dialog.py:91
msgid "<b>Homepage:</b> <a href=\"{homepage}\">{homepage}</a><br><b>Source Code:</b> <a href=\"{repo_url}\">{repo_url}</a><br><b>Report Issues:</b> <a href=\"{issues_url}\">{issues_url}</a><br><br><b>Web app:</b> Check it out <a href=\"{webapp_url}\">here</a>."
msgstr "<b>Startseite:</b> <a href=\"{homepage}\">{homepage}</a><br><b>Quellcode:</b> <a href=\"{repo_url}\">{repo_url}</a><br><b>Probleme melden:</b> <a href=\"{issues_url}\">{issues_url}</a><br><br><b>Web-App:</b> Schau sie dir <a href=\"{webapp_url}\">hier</a> an."

#: quickbib/about_dialog.py:94
msgid "<b>License:</b> Released under the <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">GNU General Public License Version 3</a>. Full text available on the <i>License</i> tab."
msgstr "<b>Lizenz:</b> Veröffentlicht unter der <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">GNU General Public License Version 3</a>. Der vollständige Text ist im Tab <i>Lizenz</i> verfügbar."

#: quickbib/about_dialog.py:106
msgid " Significant Contributors"
msgstr "Wichtige Mitwirkende"

#: quickbib/about_dialog.py:108
msgid "<a href=\"https://github.com/Kyuyrii/\">Kyuyrii</a>: Helped fix the snap package."
msgstr "<a href=\"https://github.com/Kyuyrii/\">Kyuyrii</a>: Hat geholfen, das Snap-Paket zu reparieren."

#: quickbib/about_dialog.py:110
msgid "This project was inspired by <a href=\"https://github.com/bibcure/doi2bib\">doi2bib</a>, whose development unfortunately stopped."
msgstr "Dieses Projekt wurde von <a href=\"https://github.com/bibcure/doi2bib\">doi2bib</a> inspiriert, dessen Entwicklung leider eingestellt wurde."

#: quickbib/about_dialog.py:111
msgid "This project would not have been possible without the help from GitHub Copilot."
msgstr "Ohne die Hilfe von GitHub Copilot wäre dieses Projekt nicht möglich gewesen."

#: quickbib/about_dialog.py:112
msgid "Bug reports and pull requests are welcome on the <a href=\"{repo_url}\">project's GitHub page</a>."
msgstr "Fehlerberichte und Pull Requests sind auf der <a href=\"{repo_url}\">GitHub-Seite des Projekts</a> willkommen."

#: quickbib/about_dialog.py:93
msgid "Want to help translate QuickBib? Improve an existing translation or add a new language on the <a href=\"{repo_url}\">project's GitHub page</a>."
msgstr "Möchtest du QuickBib beim Übersetzen helfen? Verbessere vorhandene Übersetzungen oder füge eine neue Sprache hinzu – auf der <a href=\"{repo_url}\">GitHub-Seite des Projekts</a>."

#: quickbib/about_dialog.py:136
msgid "<p>Unable to read LICENSE file.</p>"
msgstr "<p>LICENSE-Datei konnte nicht gelesen werden.</p>"

#: quickbib/about_dialog.py:138
msgid "<p>GPLv3 license text not found in repository. See the <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">Read it online</a>.</p>"
msgstr "<p>Der GPLv3-Lizenztext wurde im Repository nicht gefunden. Siehe <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">online lesen</a>.</p>"

