#: quickbib/about_dialog.py:92
msgid "{app_name} fetches BibTeX entries from DOIs, arXiv IDs, and known journal URLs. It is a simple utility to quickly convert identifiers into usable BibTeX records."
msgstr "{app_name} DOI, arXiv ID এবং পরিচিত জার্নাল URL থেকে BibTeX খুঁজে বার করে। এটি গবেষণাপত্রের DOI দ্রুত BibTeX-এ রূপান্তর করার একটি সহজ উপায়।"

#: quickbib/about_dialog.py:93
msgid "QuickBib uses <a href=\"https://github.com/archisman-panigrahi/doi2bib3\">doi2bib3</a> as its backend for DOI to BibTeX conversion."
msgstr "DOI থেকে BibTeX রূপান্তরের জন্য QuickBib <a href=\"https://github.com/archisman-panigrahi/doi2bib3\">doi2bib3</a> ব্যবহার করে।"

#: quickbib/about_dialog.py:95
msgid "<b>Homepage:</b> <a href=\"{homepage}\">{homepage}</a><br><b>Source Code:</b> <a href=\"{repo_url}\">{repo_url}</a><br><b>Report Issues:</b> <a href=\"{issues_url}\">{issues_url}</a><br><br><b>Web app:</b> Check it out <a href=\"{webapp_url}\">here</a>."
msgstr "<b>হোমপেজ:</b> <a href=\"{homepage}\">{homepage}</a><br><b>সোর্স কোড:</b> <a href=\"{repo_url}\">{repo_url}</a><br><b>সমস্যা জানান:</b> <a href=\"{issues_url}\">{issues_url}</a><br><br><b>ওয়েব অ্যাপ:</b> <a href=\"{webapp_url}\">এখানে দেখুন</a>।"

#: quickbib/about_dialog.py:98
msgid "<b>License:</b> Released under the <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">GNU General Public License Version 3</a>. Full text available on the <i>License</i> tab."
msgstr "<b>অনুজ্ঞাপত্র:</b> এই প্রকল্পটি <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">GNU General Public License Version 3</a> এর অধীনে প্রকাশিত। সম্পূর্ণ <i>অনুজ্ঞাপত্রটি</i> ট্যাবে আছে।"

#: quickbib/about_dialog.py:114
msgid " Significant Contributors"
msgstr "উল্লেখযোগ্য অবদানকারী"

#: quickbib/about_dialog.py:116
msgid "<a href=\"https://github.com/Kyuyrii/\">Kyuyrii</a>: Helped fix the snap package."
msgstr "<a href=\"https://github.com/Kyuyrii/\">Kyuyrii</a>: snap প্যাকেজের সমস্যাগুলি ঠিক করতে সাহায্য করেছেন।"

#: quickbib/about_dialog.py:119
msgid "This project was inspired by <a href=\"https://github.com/bibcure/doi2bib\">doi2bib</a>, whose development unfortunately stopped."
msgstr "এই প্রকল্পটি <a href=\"https://github.com/bibcure/doi2bib\">doi2bib</a> থেকে অনুপ্রাণিত। কিন্তু তা তৈরি বন্ধ হয়ে গেছে।"

#: quickbib/about_dialog.py:120
msgid "This project would not have been possible without the help from GitHub Copilot."
msgstr "GitHub Copilot-এর সহায়তা ছাড়া এই প্রকল্পটি সম্ভব হতো না।"

#: quickbib/about_dialog.py:105
msgid "Bug reports and pull requests are welcome on the <a href=\"{repo_url}\">project's GitHub page</a>."
msgstr "আমাদের <a href=\"{repo_url}\">প্রকল্পের GitHub পাতায়</a> যেকোনো ত্রুটি (bug report) জানান এবং পরিবর্তনের প্রস্তাব (pull request) পাঠান।"

#: quickbib/about_dialog.py:145
msgid "<p>Unable to read LICENSE file.</p>"
msgstr "<p>অনুজ্ঞাপত্র পড়া যায়নি।</p>"

#: quickbib/about_dialog.py:147
msgid "<p>GPLv3 license text not found in repository. See the <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">Read it online</a>.</p>"
msgstr "<p>রিপোজিটরিতে GPLv3 অনুজ্ঞাপত্র লেখাটি খুঁজে পাওয়া যায়নি। অনলাইনে <a href=\"https://www.gnu.org/licenses/gpl-3.0.en.html#license-text\">এখানে পড়ুন</a>।</p>"

